# Copy to .env and fill in. Secrets & credentials ONLY — everything else (backends,
# endpoints, model picks, ports, tuning) lives in docker-compose.yml's ${VAR:-default}
# fallbacks. The values below are the insecure dev defaults; OVERRIDE them in prod.

# ----- LiteLLM gateway master key. The api authenticates to the gateway with it.
LITELLM_MASTER_KEY=sk-tenir-master

# ----- Hugging Face token for gated/rate-limited model downloads (the STT model
# servers pull their weights from the Hub on first boot).
HF_TOKEN=

# ----- Multi-user auth. API_AUTH_SECRET MUST be overridden — the api refuses to boot
# with the default. Set the bootstrap admin to seed a first login.
API_AUTH_SECRET=dev-insecure-change-me
API_AUTH_ADMIN_USERNAME=
API_AUTH_ADMIN_PASSWORD=
API_AUTH_ADMIN_HOUSEHOLD=default

# ----- Authentik OIDC identity provider (XERK-647, epic XERK-646). OPTIONAL: only
# needed when running the separate authentik/docker-compose.authentik.yml stack.
# The vars marked (required) have no safe default — the stack refuses to start
# without them. Redirect URIs are placeholders here; T7–T10 finalize the real
# values. Finalized for the hub in T11.
#AUTHENTIK_SECRET_KEY=            # (required) `openssl rand -base64 60`
#AUTHENTIK_PG_PASS=               # (required) Authentik's own Postgres password
#AUTHENTIK_BOOTSTRAP_PASSWORD=    # (required) first-boot password for akadmin
#AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@example.com
# Tenir OIDC client + seeded identities (consumed by the blueprint):
#AUTHENTIK_TENIR_CLIENT_ID=tenir
#AUTHENTIK_TENIR_ROOT_EMAIL=admin@example.com     # MUST equal the API's API_AUTH_ADMIN_EMAIL
#AUTHENTIK_TENIR_ROOT_PASSWORD=                   # (required) tenir-root login password
#AUTHENTIK_TENIR_MEMBER_EMAIL=member@example.com
#AUTHENTIK_TENIR_MEMBER_PASSWORD=                 # (required) tenir-member login password
# Redirect URIs (coordinate with T7–T10):
#TENIR_OIDC_REDIRECT_WEB=http://localhost:8080/auth/oidc/callback
#TENIR_OIDC_REDIRECT_EVEN=http://localhost:8080/even/auth/oidc/callback
#TENIR_OIDC_REDIRECT_MOBILE=com.xerktech.tenir://auth/callback
#TENIR_PUBLIC_URL=http://localhost:8080
# Exposure (default loopback-only; the hub fronts it with its reverse proxy):
#AUTHENTIK_BIND=127.0.0.1
#AUTHENTIK_TAG=2024.12

# ----- Cue evidence retrieval (XERK-120). Deployment-specific infra, not a secret,
# but it has no safe public default: point it at YOUR SearXNG instance (JSON API
# enabled) to turn the web-search tier on, and set the retrieval backend live.
# Leaving both unset keeps cues ungrounded (pre-XERK-120 behaviour).
#API_CUE_RETRIEVAL_BACKEND=live
#API_CUE_SEARXNG_ENDPOINT=http://YOUR-SEARXNG-HOST:8585
